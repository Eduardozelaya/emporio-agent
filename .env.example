# Copy to .env and fill in. Never commit .env.

# Required for chat and live evaluation (tests run without it)
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint works (leave empty for OpenAI)
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30

# Agent guards
MAX_TOOL_STEPS=5
HISTORY_WINDOW=20

# Fixed "now" for reproducible examples/tests, ISO 8601 (leave empty for real time)
# EMPORIO_TODAY=2026-11-01T12:20:00-04:00
EMPORIO_TODAY=

EMPORIO_DATA_DIR=data
