# Copy to .env and fill in. Never commit .env.

# --- Model provider -------------------------------------------------------
# The client speaks the OpenAI protocol to whatever LLM_BASE_URL points at, so
# the key is named after its role. OPENAI_API_KEY is also accepted.
# Required for chat and live evaluation; tests run without it.
LLM_API_KEY=

# Leave LLM_BASE_URL empty for OpenAI itself. Examples of other providers:
#   Groq      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   DeepSeek  LLM_BASE_URL=https://api.deepseek.com         LLM_MODEL=deepseek-chat
#   Ollama    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30

# --- Agent guards ---------------------------------------------------------
MAX_TOOL_STEPS=5
HISTORY_WINDOW=20

# --- Reproducibility ------------------------------------------------------
# Fixed "now" for reproducible examples/tests, ISO 8601 (leave empty for real time)
# EMPORIO_TODAY=2026-11-01T12:20:00
EMPORIO_TODAY=

EMPORIO_DATA_DIR=data
