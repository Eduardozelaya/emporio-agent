# Normalise line endings so the repo is identical on Windows, Linux and CI.
* text=auto eol=lf

*.pdf binary
*.db  binary

# The challenge files are evidence, not source: store them byte for byte.
# They ship with CRLF, and `text=auto` would rewrite them to LF on checkout,
# so a clone would no longer match what the store handed us (E1 AC2).
data/raw/** -text
